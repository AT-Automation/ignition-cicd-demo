# Copy this file to .env. Do not commit .env.
ACCEPT_IGNITION_EULA=Y
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-this-before-sharing
IGNITION_EDITION=standard
TZ=Europe/Amsterdam

# Local Gateway API key, used by scripts/scan-local.sh after you edit a view.
# Create it in Gateway > Config > Security > API Keys. Never commit .env.
IGNITION_API_KEY_LOCAL=

# Production API key, used only when you deliberately run scripts/deploy.sh
# from this workstation. The GitHub deployment uses its own Environment Secret.
IGNITION_API_KEY=
