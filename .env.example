# Copy this file to .env. Do not commit .env.
ACCEPT_IGNITION_EULA=Y
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-this-before-sharing
IGNITION_EDITION=standard
TZ=Europe/Amsterdam

# API key voor de lokale Gateway, gebruikt door scripts/scan-local.sh na een view-wijziging.
# Maak hem aan via Platform > Security > API Keys. Commit .env nooit.
IGNITION_API_KEY_LOCAL=

# API key voor productie, alleen als scripts/deploy.sh bewust lokaal wordt uitgevoerd.
# De GitHub-deploy gebruikt een eigen Environment Secret.
IGNITION_API_KEY=
