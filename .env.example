# Copy this file to .env. Do not commit .env.
ACCEPT_IGNITION_EULA=Y
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-this-before-sharing
IGNITION_EDITION=standard
TZ=Europe/Amsterdam

# API key voor de lokale Gateway, gebruikt door scripts/scan-local.sh na een view-wijziging.
# Maak hem aan via Platform > Security > API Keys. Commit .env nooit.
IGNITION_API_KEY_LOCAL=

# API key voor productie. De kortlevende runner leest deze lokale,
# niet-gecommitte waarde om na de deploy een projectscan uit te voeren.
IGNITION_API_KEY=

# Alleen voor de automatische deploy in demo stap 6. Dit is een GitHub
# Personal Access Token (PAT): een API-toegangstoken waarmee de runnercontainer
# bij GitHub een tijdelijke runner-registratie voor deze repository aanvraagt.
# Maak expliciet een **Personal Access Token (classic)** (geen fine-grained
# token) met de volledige `repo` scope. Beide waarden blijven lokaal in .env;
# revoke de PAT na de demo als je hem niet opnieuw nodig hebt.
RUNNER_REPO_URL=https://github.com/<jouw-gebruikersnaam>/ignition-cicd-demo
RUNNER_GITHUB_PAT=ghp_vervang_dit_door_jouw_token
RUNNER_NAME=ignition-demo-once
