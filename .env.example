# Copy this file to .env. Do not commit .env.
ACCEPT_IGNITION_EULA=Y
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-this-before-sharing
IGNITION_EDITION=standard
TZ=Europe/Amsterdam

# Used only by scripts/deploy.sh when deploying from this workstation.
# Create an API key in Gateway > Config > Security > API Keys and keep it here.
IGNITION_API_KEY=
